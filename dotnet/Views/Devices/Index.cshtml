@model HomePulse.Models.ViewModels.DeviceListViewModel
@{
    ViewData["Title"] = "Subnet Device Discovery";
}

<div class="space-y-6">
    <!-- Top Controller Banner -->
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <div class="text-[10px] font-mono uppercase text-indigo-400 font-bold tracking-wider">
                ASP.NET 9 MVC • DevicesController.cs • Razor Index.cshtml
            </div>
            <h2 class="text-lg font-bold text-white mt-0.5 flex items-center gap-2">
                <span>Automated Local Subnet Device Inventory</span>
                <span class="text-xs font-mono font-normal px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300">
                    @Model.Devices.Count nodes listed
                </span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">
                Multi-threaded ARP scan & IEEE OUI Vendor resolution via NetworkScannerService.cs
            </p>
        </div>

        <form method="get" asp-action="Index" class="flex items-center gap-2 w-full md:w-auto">
            <input type="text" name="search" value="@Model.SearchQuery" placeholder="Filter by IP, MAC, name, vendor..." class="px-3 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-white text-xs placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" />
            <button type="submit" class="px-4 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs transition-colors">
                Search
            </button>
        </form>
    </div>

    <!-- Category Filter Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto text-xs pb-1">
        @foreach (var cat in new[] { "All", "Infrastructure", "Storage", "IoT", "Mobile", "Workstation" })
        {
            var isSelected = Model.SelectedCategory.Equals(cat, StringComparison.OrdinalIgnoreCase);
            <a asp-action="Index" asp-route-category="@(cat == "All" ? "" : cat)" asp-route-search="@Model.SearchQuery" class="px-3.5 py-1.5 rounded-xl font-medium transition-all @(isSelected ? "bg-indigo-600 text-white shadow-md" : "bg-slate-900 border border-slate-800 text-slate-400 hover:bg-slate-800")">
                @cat
            </a>
        }
    </div>

    <!-- Device Cards Grid with SVG Gauges -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var device in Model.Devices)
        {
            <div class="p-5 rounded-2xl bg-slate-900 border border-slate-800 shadow-md space-y-4 hover:border-slate-700 transition-colors">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-indigo-400">
                            <i class="fa-solid fa-server"></i>
                        </div>
                        <div>
                            <div class="font-bold text-white text-xs flex items-center gap-1.5">
                                <span class="truncate max-w-[180px]">@device.CustomAlias</span>
                                @if (device.IsWhitelisted)
                                {
                                    <i class="fa-solid fa-shield-check text-emerald-400" title="Whitelisted Device"></i>
                                }
                            </div>
                            <div class="text-[11px] font-mono text-slate-400 mt-0.5">@device.IpAddress</div>
                        </div>
                    </div>

                    <!-- Mini Latency Arc Gauge -->
                    <div class="flex flex-col items-center">
                        <span class="w-2 h-2 rounded-full @(device.IsOnline ? "bg-emerald-500" : "bg-rose-500") mb-1"></span>
                        <span class="font-mono font-bold text-xs text-white">@(device.IsOnline ? $"{device.PingLatencyMs}ms" : "Down")</span>
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-800 space-y-1 text-[11px] font-mono text-slate-400">
                    <div class="flex justify-between">
                        <span>Vendor (OUI):</span>
                        <span class="text-slate-300 font-sans truncate max-w-[170px]">@device.Vendor</span>
                    </div>
                    <div class="flex justify-between">
                        <span>MAC:</span>
                        <span class="text-slate-300">@device.MacAddress</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Role:</span>
                        <span class="px-1.5 py-0.2 rounded bg-slate-800 text-indigo-300">@device.Category</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
