@model HomePulse.Models.ViewModels.StorageViewModel
@{
    ViewData["Title"] = "NAS & Storage Infrastructure";
}

<div class="space-y-6">
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl flex items-center justify-between">
        <div>
            <div class="text-[10px] font-mono uppercase text-amber-400 font-bold tracking-wider">
                ASP.NET 9 MVC • StorageController.cs • Razor Index.cshtml
            </div>
            <h2 class="text-lg font-bold text-white mt-0.5">Enterprise NAS & Storage Arrays</h2>
            <p class="text-xs text-slate-400 mt-1">
                Real-time SNMP & API telemetry for Synology DSM 7.2 (DS920+) & TrueNAS Scale
            </p>
        </div>
        <div class="text-right">
            <div class="text-xs text-slate-400 font-mono">Total Monitored Storage</div>
            <div class="text-xl font-bold font-mono text-white">@Model.TotalUsedTb TB <span class="text-slate-500 text-sm font-normal">/ @Model.TotalAllocatedTb TB</span></div>
        </div>
    </div>

    <!-- NAS Nodes Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        @foreach (var node in Model.Nodes)
        {
            var usedPct = node.DiskTotalBytes > 0 ? Math.Round((double)node.DiskUsedBytes / node.DiskTotalBytes * 100, 1) : 0;
            <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-lg space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="font-bold text-base text-white flex items-center gap-2">
                            <span>@node.Name</span>
                            <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-slate-800 text-amber-300 border border-amber-800/40">
                                @node.NasType
                            </span>
                        </div>
                        <div class="text-xs text-slate-400 font-mono mt-0.5">@node.IpAddress • Pool: @node.PoolName</div>
                    </div>
                    <span class="px-2.5 py-1 rounded-full text-xs font-mono font-bold bg-emerald-950 text-emerald-300 border border-emerald-800">
                        @node.RaidStatus
                    </span>
                </div>

                <!-- Storage Gauge & CPU/RAM Gauges -->
                <div class="grid grid-cols-3 gap-4 pt-2">
                    <!-- Gauge 1: Disk Capacity Ring Gauge -->
                    <div class="flex flex-col items-center text-center p-3 rounded-xl bg-slate-950/60 border border-slate-800">
                        <span class="text-[10px] text-slate-400 font-mono mb-2">Volume Used</span>
                        <div class="relative w-16 h-16 flex items-center justify-center">
                            <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#1e293b" stroke-width="3.8" />
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#06b6d4" stroke-width="3.8" stroke-dasharray="@usedPct, 100" />
                            </svg>
                            <span class="absolute font-mono font-bold text-xs text-white">@usedPct%</span>
                        </div>
                        <span class="text-[10px] text-slate-400 font-mono mt-1.5">@Math.Round(node.DiskUsedBytes / 1e12, 1) TB used</span>
                    </div>

                    <!-- Gauge 2: CPU Ring Gauge -->
                    <div class="flex flex-col items-center text-center p-3 rounded-xl bg-slate-950/60 border border-slate-800">
                        <span class="text-[10px] text-slate-400 font-mono mb-2">CPU Utilization</span>
                        <div class="relative w-16 h-16 flex items-center justify-center">
                            <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#1e293b" stroke-width="3.8" />
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#10b981" stroke-width="3.8" stroke-dasharray="@node.CpuPercent, 100" />
                            </svg>
                            <span class="absolute font-mono font-bold text-xs text-white">@node.CpuPercent%</span>
                        </div>
                        <span class="text-[10px] text-emerald-400 font-mono mt-1.5">Intel Celeron</span>
                    </div>

                    <!-- Gauge 3: RAM Ring Gauge -->
                    <div class="flex flex-col items-center text-center p-3 rounded-xl bg-slate-950/60 border border-slate-800">
                        <span class="text-[10px] text-slate-400 font-mono mb-2">RAM Allocation</span>
                        <div class="relative w-16 h-16 flex items-center justify-center">
                            <svg class="w-16 h-16 -rotate-90" viewBox="0 0 36 36">
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#1e293b" stroke-width="3.8" />
                                <path d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="#8b5cf6" stroke-width="3.8" stroke-dasharray="@node.MemoryPercent, 100" />
                            </svg>
                            <span class="absolute font-mono font-bold text-xs text-white">@node.MemoryPercent%</span>
                        </div>
                        <span class="text-[10px] text-purple-400 font-mono mt-1.5">DDR4 Non-ECC</span>
                    </div>
                </div>

                <!-- Drive Thermal Gauges -->
                <div class="pt-4 border-t border-slate-800">
                    <div class="text-xs font-bold text-slate-300 mb-3 flex items-center gap-1.5">
                        <i class="fa-solid fa-temperature-half text-amber-400"></i>
                        <span>Physical Drive SMART Thermal Gauges</span>
                    </div>
                    <div class="grid grid-cols-4 gap-2 text-center text-xs">
                        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                            <div class="text-[10px] text-slate-400 font-mono">Bay 1 (WD Red)</div>
                            <div class="font-mono font-bold text-sm text-emerald-400 mt-1">32°C</div>
                            <span class="text-[9px] text-slate-500 uppercase">Cool</span>
                        </div>
                        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                            <div class="text-[10px] text-slate-400 font-mono">Bay 2 (WD Red)</div>
                            <div class="font-mono font-bold text-sm text-emerald-400 mt-1">33°C</div>
                            <span class="text-[9px] text-slate-500 uppercase">Cool</span>
                        </div>
                        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                            <div class="text-[10px] text-slate-400 font-mono">Bay 3 (IronWolf)</div>
                            <div class="font-mono font-bold text-sm text-emerald-400 mt-1">34°C</div>
                            <span class="text-[9px] text-slate-500 uppercase">Cool</span>
                        </div>
                        <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800">
                            <div class="text-[10px] text-slate-400 font-mono">Bay 4 (IronWolf)</div>
                            <div class="font-mono font-bold text-sm text-emerald-400 mt-1">35°C</div>
                            <span class="text-[9px] text-slate-500 uppercase">Cool</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
