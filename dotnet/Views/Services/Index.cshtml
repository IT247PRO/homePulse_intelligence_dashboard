@model HomePulse.Models.ViewModels.ServiceHealthViewModel
@{
    ViewData["Title"] = "Websites & SSL Sentinel Monitor";
}

<div class="space-y-6">
    <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
            <div class="text-[10px] font-mono uppercase text-emerald-400 font-bold tracking-wider">
                ASP.NET 9 MVC • ServicesController.cs • Razor Index.cshtml
            </div>
            <h2 class="text-lg font-bold text-white mt-0.5">HTTP/HTTPS Endpoints & SSL Certificate Sentinel</h2>
            <p class="text-xs text-slate-400 mt-1">
                Continuous synthetic probes every 60s testing HTTP status codes, TLS 1.3 handshake, and SSL certificate expiration.
            </p>
        </div>

        <button type="button" onclick="document.getElementById('addServiceForm').classList.toggle('hidden')" class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs shadow-md transition-colors flex items-center gap-2 shrink-0">
            <i class="fa-solid fa-plus"></i>
            <span>Monitor a Website</span>
        </button>
    </div>

    <!-- Add Website Form -->
    <div id="addServiceForm" class="hidden p-6 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl">
        <form method="post" asp-action="Create" class="grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
            @Html.AntiForgeryToken()
            <div class="md:col-span-1">
                <label class="text-[10px] text-slate-500 font-mono uppercase">Name</label>
                <input type="text" name="Name" required maxlength="128" placeholder="My Website" class="w-full mt-1 px-2.5 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500" />
            </div>
            <div class="md:col-span-2">
                <label class="text-[10px] text-slate-500 font-mono uppercase">URL</label>
                <input type="text" name="TargetUrl" required maxlength="512" placeholder="https://example.com" class="w-full mt-1 px-2.5 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500" />
            </div>
            <div class="md:col-span-1">
                <label class="text-[10px] text-slate-500 font-mono uppercase">Expected Status</label>
                <input type="number" name="ExpectedStatusCode" value="200" class="w-full mt-1 px-2.5 py-1.5 rounded-lg bg-slate-800 border border-slate-700 text-white text-xs focus:outline-none focus:ring-1 focus:ring-emerald-500" />
            </div>
            <div class="md:col-span-4">
                <button type="submit" class="w-full px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors">
                    Start Monitoring
                </button>
            </div>
        </form>
    </div>

    <!-- Monitored Services Grid -->
    @if (Model.Services.Count == 0)
    {
        <div class="p-10 rounded-2xl bg-slate-900 border border-slate-800 text-center text-slate-500 text-xs">
            No websites monitored yet. Click "Monitor a Website" to add one.
        </div>
    }
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var s in Model.Services)
        {
            var isSslWarning = s.SslDaysRemaining.HasValue && s.SslDaysRemaining < 14;
            <div data-service-id="@s.Id" class="p-5 rounded-2xl bg-slate-900 border @(isSslWarning ? "border-amber-800/80 bg-amber-950/10" : "border-slate-800") shadow-md space-y-4 @(!s.IsEnabled ? "opacity-50" : "")">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="font-bold text-white text-xs flex items-center gap-1.5">
                            <span>@s.Name</span>
                            <span data-field="status-code" class="text-[10px] font-mono px-1.5 py-0.2 rounded @(s.IsOnline ? "bg-emerald-950 text-emerald-300 border border-emerald-800" : "bg-rose-950 text-rose-300 border border-rose-800")">
                                @s.LastStatusCode
                            </span>
                            @if (!s.IsEnabled)
                            {
                                <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-slate-800 text-slate-400 border border-slate-700">Paused</span>
                            }
                        </div>
                        <a href="@s.TargetUrl" target="_blank" class="text-[11px] font-mono text-slate-400 hover:text-indigo-400 truncate block max-w-[200px] mt-0.5">
                            @s.TargetUrl
                        </a>
                    </div>

                    <div class="text-right font-mono">
                        <span data-field="latency" class="text-xs font-bold text-white">@s.ResponseLatencyMs ms</span>
                        <div class="text-[10px] text-slate-500">RTT</div>
                    </div>
                </div>

                <!-- SSL Expiration Arc / Badge -->
                <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-400">SSL Expiration:</span>
                    @if (s.SslDaysRemaining.HasValue)
                    {
                        <span class="px-2 py-0.5 rounded @(isSslWarning ? "bg-amber-500/20 text-amber-300 font-bold border border-amber-500/40" : "text-emerald-400")">
                            @s.SslDaysRemaining days remaining
                        </span>
                    }
                    else
                    {
                        <span class="text-slate-500">N/A (HTTP)</span>
                    }
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <form method="post" asp-action="ToggleEnabled" class="flex-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="w-full px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 font-semibold text-[11px] transition-colors">
                            @(s.IsEnabled ? "Pause" : "Resume")
                        </button>
                    </form>
                    <form method="post" asp-action="Delete" class="flex-1" onsubmit="return confirm('Stop monitoring @s.Name?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="w-full px-3 py-1.5 rounded-lg bg-rose-950/60 hover:bg-rose-900 border border-rose-800 text-rose-300 font-semibold text-[11px] transition-colors">
                            Remove
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
